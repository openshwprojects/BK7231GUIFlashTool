<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- Allow the app to load its own dependency DLLs even when the ZIP was downloaded from the internet (Mark-of-the-Web). -->
    <loadFromRemoteSources enabled="true" />
    <!-- Binding redirects for System.Text.Json & friends are generated at build time into BK7231Flasher.exe.config (AutoGenerateBindingRedirects). -->
  </runtime>
</configuration>
